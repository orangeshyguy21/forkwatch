# Forkwatch regtest knobs — the single place to tweak the simulated chain.
#
#   edit this file, then:  bash scripts/regtest.sh reset
#   one-off:               bash scripts/regtest.sh reset LEAD_BLOCKS=20
#
# The regtest chain is a FULL-SCALE MIRROR of the mainnet deployment: same heights, same epoch
# boundaries, only the clock is faster. Mainnet's floor (927360) and fork (961632) both sit exactly
# on 2016-block retarget boundaries, 17 epochs apart; the settings below reproduce those numbers
# exactly, so every height-, epoch- and ETA-dependent code path in the app runs against the literal
# values it will see in production.
#
# The price is that a reset mines ~961,632 blocks, which takes a couple of hours. You pay it ONCE:
# the reset finishes by saving a snapshot of the parked pre-fork chain, and
# `bash scripts/regtest.sh restore` puts you back there in under a minute, as many times as you like.
#
# FLOOR_HEIGHT is derived at reset time (FORK_AT_HEIGHT - VISIBLE_EPOCHS*RETARGET_INTERVAL) and
# written to compose/.regtest.runtime.env. Everything below is yours to change.

# Seconds per block — mainnet's 600, scaled down. Used for BOTH the historical timestamps written
# during the reset AND the live miner's cadence, so measured spacing matches intent and the header
# ETA is honest. This is the master pacing knob: at 4s the LEAD_BLOCKS countdown below is ~2min.
#
# 4s is the FLOOR, not a free parameter — it is set by the frontend's new-block spawn animation,
# which must finish before the next block lands or it gets cut off mid-flight (IsometricChain's
# materialize timer is re-pointed at the new tip the moment it arrives). The spawn's timeline, in
# ms from materialize (IsoBlock.tsx / ViolationStickers.tsx / IsometricChain.tsx):
#
#   0     chain grows link-by-link toward the new block   (CHAIN_BUILD_MS 480)
#   700   base diamond draws                              (+320 draw, +1100 pulse)
#   980   cube rain falls                                 (VOX period 1000 + fall 420 -> 2400)
#   2350  panels slide in and seal                        (+440 -> 2790; fill rise +640 -> 2990)
#   2900  violation stickers slap on                      (+420, +150 per extra -> ~3470 worst case)
#   3200  IsometricChain drops the animation classes      (matTimer — the authored end of the spawn)
#
# So the full sequence needs ~3.2s, or ~3.5s on the fork block itself (the only one carrying two
# stickers). 4s clears that with ~0.5s of buffer and is the smallest whole second that does — 3s
# would clip the panels. Keep it a whole number: the backend parses TARGET_SPACING_SECS as an
# integer and silently ignores a fractional value, which switches off the ETA's retarget clamp.
# Keep it a multiple of POLL_MS too (see the bottom of this file).
BLOCK_SPACING_SECS=4

# Blocks between the post-reset tip and the fork — the "watch it coming" window the miner walks
# live. LEAD_BLOCKS * BLOCK_SPACING_SECS seconds until the chains split. At 30 the chain parks at
# 961602 and every `restore` gives you a ~2min countdown to the mandatory-signaling height.
#
# This is the knob to turn for a shorter wait, NOT `fork-now` — that re-points the fork at the
# current tip and so gives up the pinned 961632.
#
# NOTE: this is applied by `reset`, which mines the chain. The saved 'prefork' snapshot was taken
# at a lead of 100 (parked at 961532), so `restore` lands there regardless of what this says; the
# miner then walks the remaining blocks at BLOCK_SPACING_SECS. Only a full reset re-parks the tip.
LEAD_BLOCKS=30

# The height of the fork itself. Pinned to mainnet's 961632 — the first block of epoch 477
# (961632 = 477 * 2016) — so the regtest chain forks at the same number the real one will.
# MUST be a multiple of RETARGET_INTERVAL; the build refuses a value that would fork mid-epoch.
# Set to 0 to fall back to the old behavior: derive a fork height from wherever RDTS activation
# landed, giving a ~6k-block chain that resets in a couple of minutes instead of a couple of hours.
FORK_AT_HEIGHT=961632

# Size of the app's visible window, in 2016-block retarget epochs: FLOOR_HEIGHT = FORK_AT_HEIGHT -
# VISIBLE_EPOCHS*2016. 17 is mainnet's (961632 - 17*2016 = 927360, the deployment's floor). 2 is the
# practical minimum that keeps a full retarget period of history below the fork, which is what the
# signaling gauge measures over — useful with FORK_AT_HEIGHT=0 for a quick throwaway chain.
# Raising this lengthens the reset (more blocks to mine and to backfill into the app's SQLite).
VISIBLE_EPOCHS=17

# Blocks per difficulty epoch. Mainnet's 2016; also the BIP9 signaling period the gauge reports.
RETARGET_INTERVAL=2016

# PRE-FORK, on the shared chain: Knots' hashrate in blocks per 100. 1 ~= reality. Applies to both
# the prefilled history and the live miner, so the chain's bit-4 share matches the hashrate story
# throughout. Only blocks above FLOOR_HEIGHT are interleaved this way — history below the floor is
# never ingested by the app, so it is bulk-mined on Core for speed.
KNOTS_PER_100=1

# POST-FORK, on its own branch: how often Knots mines. Once the chains split there is no shared tip
# to contend for, so the minority chain runs on its own clock instead of a share of Core's. At 3x
# BLOCK_SPACING_SECS the split widens ~3:1 — Knots visibly alive, visibly losing. Extrapolating
# KNOTS_PER_100 here instead would mean one Knots block every ~30 minutes: true to a 1% hashrate,
# useless to watch. Scaled with BLOCK_SPACING_SECS (was 60s when that was 20s) to hold the 3:1;
# leaving it at 60 against a 4s Core cadence would make the minority chain look frozen, not losing.
KNOTS_INTERVAL_SECS=12

# Bytes of OP_RETURN payload in the fork-triggering tx. Anything over 83 violates RDTS rule 1.
VIOLATION_BYTES=200

# Fallback fork distance used only if the miner starts on a chain already past FORK_AT_HEIGHT
# (e.g. you restarted the miner after the fork). Normal resets never hit this.
PRE_FORK_BLOCKS=18

# What the UI header calls the countdown target.
FORK_LABEL=Scheduled fork

# App ingest poll interval (ms). This is the delay between a block existing on the node and the
# frontend being told about it, so it is also the JITTER on the spacing the animation actually
# sees: a block mined just after a poll tick waits nearly a whole POLL_MS. Keep BLOCK_SPACING_SECS
# an exact multiple of it — then the quantisation offset is the same for every block and cancels
# out, leaving the observed spacing equal to the mining cadence instead of bouncing around it by
# up to a poll period (which is what would eat the spawn animation's buffer).
POLL_MS=500
